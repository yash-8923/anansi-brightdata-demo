# Copy to .env and fill in — never commit the real .env file.

# Bright Data account API token: Settings -> API keys on brightdata.com
BRIGHTDATA_API_KEY=

# The c_* Collector ID printed by `bdata scraper create` (see SETUP.md)
BRIGHTDATA_COLLECTOR_ID=

# Optional: disable Anansi's own anti-bot escalation (for debugging only)
# ANANSI_DISABLE_ANTIBOT=1
